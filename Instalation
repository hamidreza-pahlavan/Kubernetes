######################### setup ip static###############

#vi /etc/netplan/00-installer-config.yaml
change network vm to Bridged and check name of network Driver
then add command to file 00-installer-config.yaml
Notice: set ip to pc vlan/ip
----
network:
  ethernets:
    ens33:
      dhcp4: no
      addresses:
      - 192.168.100.2/24
      routes:
        - to: 0.0.0.0/0
          via: 192.168.100.1
      nameservers:
        addresses:
        - 8.8.8.8
        search: []
  version: 2

---
#netplan apply

